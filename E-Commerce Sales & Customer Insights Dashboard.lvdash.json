{
  "datasets": [
    {
      "name": "0dd65403",
      "displayName": "Customer Counts by State Overview",
      "queryLines": [
        "USE CATALOG `workspace`;\n",
        "USE SCHEMA `ei_dashboard`;\n",
        "\n",
        "SELECT state, COUNT(*) AS total_customers\n",
        "FROM customers\n",
        "GROUP BY state\n",
        "ORDER BY total_customers DESC;"
      ]
    },
    {
      "name": "b75f82ad",
      "displayName": "Active Customers by State",
      "queryLines": [
        "SELECT\n",
        "  c.state,\n",
        "  COUNT(DISTINCT c.customer_id) AS active_customers\n",
        "FROM\n",
        "  customers c\n",
        "    JOIN (\n",
        "      SELECT\n",
        "        customer_id\n",
        "      FROM\n",
        "        orders\n",
        "      GROUP BY\n",
        "        customer_id\n",
        "      HAVING\n",
        "        COUNT(order_id) > 1\n",
        "    ) repeat_buyers\n",
        "      ON c.customer_id = repeat_buyers.customer_id\n",
        "GROUP BY\n",
        "  c.state\n",
        "ORDER BY\n",
        "  active_customers DESC"
      ],
      "catalog": "workspace",
      "schema": "ei_dashboard"
    },
    {
      "name": "total_orders",
      "displayName": "Total Orders",
      "queryLines": [
        "SELECT\n",
        "  COUNT(*) AS total_orders\n",
        "FROM\n",
        "  orders"
      ],
      "catalog": "workspace",
      "schema": "ei_dashboard"
    },
    {
      "name": "orders_by_status",
      "displayName": "Orders by Status",
      "queryLines": [
        "SELECT\n",
        "  order_status,\n",
        "  COUNT(*) AS order_count\n",
        "FROM\n",
        "  orders\n",
        "GROUP BY\n",
        "  order_status\n",
        "ORDER BY\n",
        "  order_count DESC"
      ],
      "catalog": "workspace",
      "schema": "ei_dashboard"
    },
    {
      "name": "orders_per_customer",
      "displayName": "Orders per Customer",
      "queryLines": [
        "SELECT\n",
        "  order_count,\n",
        "  COUNT(*) AS customer_count\n",
        "FROM\n",
        "  (\n",
        "    SELECT\n",
        "      customer_id,\n",
        "      COUNT(order_id) AS order_count\n",
        "    FROM\n",
        "      orders\n",
        "    GROUP BY\n",
        "      customer_id\n",
        "  )\n",
        "GROUP BY\n",
        "  order_count\n",
        "ORDER BY\n",
        "  order_count"
      ],
      "catalog": "workspace",
      "schema": "ei_dashboard"
    },
    {
      "name": "total_products",
      "displayName": "Total Products",
      "queryLines": [
        "SELECT\n",
        "  COUNT(*) AS total_products\n",
        "FROM\n",
        "  products"
      ],
      "catalog": "workspace",
      "schema": "ei_dashboard"
    },
    {
      "name": "top_expensive_products",
      "displayName": "Top Expensive Products",
      "queryLines": [
        "SELECT\n",
        "  product_name,\n",
        "  product_price\n",
        "FROM\n",
        "  products\n",
        "ORDER BY\n",
        "  product_price DESC\n",
        "LIMIT 5"
      ],
      "catalog": "workspace",
      "schema": "ei_dashboard"
    },
    {
      "name": "product_by_category",
      "displayName": "Product Distribution by Category",
      "queryLines": [
        "SELECT\n",
        "  c.category_name,\n",
        "  COUNT(p.Product_id) AS product_count\n",
        "FROM\n",
        "  products p\n",
        "    JOIN categories c\n",
        "      ON p.Product_category_id = c.category_id\n",
        "GROUP BY\n",
        "  c.category_name\n",
        "ORDER BY\n",
        "  product_count DESC"
      ],
      "catalog": "workspace",
      "schema": "ei_dashboard"
    },
    {
      "name": "category_by_department",
      "displayName": "Category by Department",
      "queryLines": [
        "SELECT\n",
        "  d.department_name,\n",
        "  COUNT(c.category_id) AS category_count\n",
        "FROM\n",
        "  departments d\n",
        "    LEFT JOIN categories c\n",
        "      ON d.department_id = c.category_department_id\n",
        "GROUP BY\n",
        "  d.department_name\n",
        "ORDER BY\n",
        "  category_count DESC"
      ],
      "catalog": "workspace",
      "schema": "ei_dashboard"
    },
    {
      "name": "orders_over_time",
      "displayName": "Orders Over Time",
      "queryLines": [
        "SELECT\n",
        "  order_date,\n",
        "  COUNT(*) AS order_count\n",
        "FROM\n",
        "  orders\n",
        "GROUP BY\n",
        "  order_date\n",
        "ORDER BY\n",
        "  order_date"
      ],
      "catalog": "workspace",
      "schema": "ei_dashboard"
    }
  ],
